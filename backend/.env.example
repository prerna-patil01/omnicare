# Copy to backend/.env and fill in. .env is gitignored.
#
# Generate real secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

FLASK_ENV=development

SECRET_KEY=PSo9qepyZsAudVylcLPEzBDY3ry8_LrXdKfy4NyGgOuT_RpCA7R7G4ULiC7l1ULR
JWT_SECRET_KEY=KR0ATQtDI6tOHI_aVjWY7hwOgtKcaP-etVcq9Rh30kWhzYFDZ5LPJaq02Z6e5sq-

# Access tokens stay short-lived; the refresh token carries the session.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Defaults to backend/instance/omnicare.db when unset.
# Postgres: postgresql+psycopg://user:pass@localhost:5432/omnicare
DATABASE_URL=

# Ask Omni — Groq's OpenAI-compatible API is the default adapter. Create an
# API key in your Groq console and set it locally; never commit the real key.
# Override LLM_BASE_URL / LLM_MODEL for another OpenAI-compatible provider.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Comma-separated exact origins. No wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
